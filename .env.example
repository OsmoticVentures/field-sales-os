# Names only. Real values live in the old app's Vercel project and are
# copied over per feature as each port needs them; never commit a value here.

# PIN gate (shared core)
NB_PIN=
NB_SESSION_SECRET=
NB_DEVICE_LIMIT=

# Device registry (shared core), also doubles as the idempotency-key store
# once nb_idempotency_keys exists there (see PORTING.md)
NB_SUPABASE_URL=
NB_SUPABASE_SERVICE_ROLE_KEY=

# Expenses: photo classifier
ANTHROPIC_API_KEY=

# Expenses: Drive/Sheets filing (this feature's own OAuth app)
NB_EXPENSES_GOOGLE_CLIENT_ID=
NB_EXPENSES_GOOGLE_CLIENT_SECRET=
NB_EXPENSES_GOOGLE_REFRESH_TOKEN=

# Visit Logger: touchpoint extraction reuses ANTHROPIC_API_KEY above.
# HubSpot filing stays off until NB_HUBSPOT_WRITE_ENABLED is exactly "true".
NB_HUBSPOT_TOKEN=
NB_HUBSPOT_WRITE_ENABLED=

# Search: the area map (client-side key, restricted to this domain)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Prospect: "Enrich further" cross-checks the business's own Google Places
# listing for hours (reuses ANTHROPIC_API_KEY above for the Angle prompt)
NB_PLACES_API_KEY=

# Route: lunch/hotel/other stop lookup reuses NB_PLACES_API_KEY above.
# The Scriptable home-screen widget's own bearer (never NB_SESSION_SECRET).
NB_WIDGET_TOKEN=
# This app's own public origin, read at request time, never hard-coded
# (the widget's deep links and account_url point here).
NB_PUBLIC_ORIGIN=
# Route: widget mileage odometer photo reads reuse ANTHROPIC_API_KEY above
# and file through the same Drive/Sheets tree as Expenses
# (NB_EXPENSES_GOOGLE_CLIENT_ID/SECRET/REFRESH_TOKEN above).

# Outbound: the grounded email composer reuses ANTHROPIC_API_KEY above and
# reads/writes nb_outbound_drafts, voice_lessons, voice_pairs in the same
# Supabase project as NB_SUPABASE_URL/NB_SUPABASE_SERVICE_ROLE_KEY above.
# "Mark sent" files through Visit Logger's autoFileEngagement, gated the
# same way by NB_HUBSPOT_WRITE_ENABLED above.
